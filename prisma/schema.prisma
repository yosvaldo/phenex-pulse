generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  DEV
  ADMIN
}

enum GoodsStatus {
  PRODUCTION
  TRANSIT
  TRANSPORT
  READY
}

enum PaymentStatus {
  OUTSTANDING
  OVERDUE
  PAID
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Factory {
  id        String   @id @default(cuid())
  name      String
  location  String?
  logoUrl   String?
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Distributor {
  id        String    @id @default(cuid())
  name      String
  location  String?
  logoUrl   String?
  invoices  Invoice[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id           String   @id @default(cuid())
  name         String
  sku          String   @unique
  description  String?
  reorderPoint Int      @default(0)
  reorderRule  String?
  currentStock Int      @default(0)
  orders       Order[]
  invoices     InvoiceItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Order {
  id             String      @id @default(cuid())
  factoryId      String
  productId      String
  quantity       Int
  status         GoodsStatus @default(PRODUCTION)
  productionDays Int         // 15, 30, 45, 60, or 75
  orderDate      DateTime    @default(now())
  estimatedArrival DateTime?
  
  factory        Factory     @relation(fields: [factoryId], references: [id])
  product        Product     @relation(fields: [productId], references: [id])
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Invoice {
  id            String        @id @default(cuid())
  distributorId String
  status        PaymentStatus @default(OUTSTANDING)
  totalAmount   Float
  dueDate       DateTime
  paidAt        DateTime?
  
  distributor   Distributor   @relation(fields: [distributorId], references: [id])
  items         InvoiceItem[]
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  productId String
  quantity  Int
  price     Float

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}