<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: 'Helvetica Neue', sans-serif; background-color: #0f172a; color: #f8fafc; margin: 0; padding: 20px; }
        .card { max-width: 600px; background-color: #020617; border: 1px solid #1e293b; border-radius: 12px; padding: 32px; margin: 0 auto; }
        h1 { color: #f59e0b; font-size: 20px; text-transform: uppercase; letter-spacing: 1px; border-bottom: 1px solid #1e293b; padding-bottom: 16px; margin-top: 0; }
        .item { background-color: #0f172a; border: 1px solid #1e293b; padding: 16px; border-radius: 8px; margin-bottom: 12px; }
        .title { font-weight: bold; color: #ffffff; font-size: 16px; margin-bottom: 4px; }
        .meta { color: #94a3b8; font-size: 13px; margin: 2px 0; }
        .alert { color: #ef4444; font-weight: bold; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🚨 Low Stock Alert</h1>
        <p style="color: #94a3b8; font-size: 14px; margin-bottom: 24px;">The following items have fallen below their reorder threshold and require immediate factory requests.</p>
        
        {{#each products}}
        <div class="item">
            <div class="title">{{this.name}} ({{this.sku}})</div>
            <p class="meta">Current Stock: <span class="alert">{{this.currentStock}}</span> / Threshold: {{this.reorderPoint}}</p>
            <p class="meta">Suggested Action: <strong>Order from Factory</strong></p>
        </div>
        {{/each}}
    </div>
</body>
</html>